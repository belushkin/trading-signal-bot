# Generate a URL-safe password, for example: openssl rand -hex 32
POSTGRES_DB=stellar
POSTGRES_USER=stellar
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password

BOT_HORIZON_URL=https://horizon.stellar.org
BOT_MONITORED_PAIRS=
# Enabled entries from the packaged watchlist; empty disables all defaults.
BOT_WATCHLIST_ENABLED=USDC,SHX,VELO,AQUA
BOT_WHALE_THRESHOLDS=
BOT_POLL_INTERVAL_SECONDS=15
BOT_VOLUME_BASELINE_SAMPLES=20
BOT_VOLUME_ANOMALY_MULTIPLIER=3
BOT_LARGE_ORDER_THRESHOLD=10000
BOT_LARGE_TRADE_MIN_XLM=10000
BOT_SPREAD_THRESHOLD_PERCENT=1
BOT_PRICE_ANOMALY_FLOOR_PERCENT=1
BOT_PRICE_WINDOWS_MINUTES=5,15,60,240
BOT_RETENTION_DAYS=30
BOT_LOG_LEVEL=INFO

# Dashboard binds to localhost by default; use a private address and firewall if exposing on a LAN.
DASHBOARD_BIND_ADDRESS=127.0.0.1
DASHBOARD_PORT=8080
DASHBOARD_REFRESH_SECONDS=20
